{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm show *)",
      "PowerShell(openclaw channels *)",
      "PowerShell(schtasks /Query *)",
      "PowerShell(openclaw status *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ScheduledTask *)",
      "PowerShell(Get-Command *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh release create *)",
      "Bash(gh repo create *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git pull)",
      "PowerShell(git pull *)",
      "PowerShell(git fetch)",
      "PowerShell(git fetch *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr close *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -File .claude\\stop-hook.ps1"
          }
        ]
      }
    ]
  }
}
